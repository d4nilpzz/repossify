      "visibility": "PUBLIC",
      "redeployment": true,
      "preserveSnapshots": 5,
      "proxied": []
    },
    {
      "name": "private",
      "path": "/private",
      "isPrivate": true,
      "visibility": "PRIVATE",
      "redeployment": false,
      "preserveSnapshots": 0,
      "proxied": []
    }
  ]
}
